{
  "name": "on-the-record",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "What an ordinary action, and an ordinary day, put on the record about you. Offline, telemetry-free.",
  "license": "SEE LICENSE IN LICENSING.md",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:no-network": "node scripts/check-no-network.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "test": "npm run validate:content && npm run check:no-network",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@fontsource/archivo-narrow": "^5.2.9",
    "@fontsource/spectral": "^5.2.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tauri-apps/cli": "^2.9.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  }
}
